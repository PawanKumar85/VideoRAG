# ==============================================================================
# VidSearch LLM Configuration Template
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
# ==============================================================================

# LLM Provider: 'ollama' (local default), 'groq', 'openrouter', 'huggingface', 'anthropic'
LLM_PROVIDER=ollama

# Model name:
# - Ollama (local): llama3:8b, mistral, llama3.2, etc.
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# - OpenRouter: anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
# - Hugging Face: meta-llama/Meta-Llama-3-8B-Instruct
# - Anthropic: claude-3-5-haiku-latest
LLM_MODEL=llama3:8b

# Host / Endpoint URL (default is local URL for Ollama)
LLM_HOST=http://localhost:11434

# API Key (not needed for local Ollama; required for Groq, OpenRouter, HF, Anthropic)
LLM_API_KEY=

# Maximum tokens for answer generation
LLM_MAX_TOKENS=400
